<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="S1Utility.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <!-- Shared brush palette. Single source of truth for both XAML and C#.
             The Theme class resolves these by x:Key at runtime via
             Application.Current.Resources; XAML styles bind via StaticResource. -->

        <!-- ── Surface backgrounds ───────────────────────────────────────── -->
        <SolidColorBrush x:Key="BgApp">#0E0E12</SolidColorBrush>
        <SolidColorBrush x:Key="BgWindow">#15151A</SolidColorBrush>
        <SolidColorBrush x:Key="BgToolbar">#181820</SolidColorBrush>
        <SolidColorBrush x:Key="BgCard">#161616</SolidColorBrush>
        <SolidColorBrush x:Key="BgChip">#1F1F26</SolidColorBrush>
        <SolidColorBrush x:Key="BgChipHov">#23232C</SolidColorBrush>
        <SolidColorBrush x:Key="BgInput">#1A1A24</SolidColorBrush>

        <!-- ── Borders ────────────────────────────────────────────────────── -->
        <SolidColorBrush x:Key="BdCard">#232323</SolidColorBrush>
        <SolidColorBrush x:Key="BdToolbar">#2C2C36</SolidColorBrush>
        <SolidColorBrush x:Key="BdInset">#1E1E26</SolidColorBrush>
        <SolidColorBrush x:Key="BdChip">#333344</SolidColorBrush>
        <SolidColorBrush x:Key="BdRow">#1D1D1D</SolidColorBrush>

        <!-- ── Text ──────────────────────────────────────────────────────── -->
        <SolidColorBrush x:Key="FgHi">#CCCCDD</SolidColorBrush>
        <SolidColorBrush x:Key="FgVal">#A0A0B5</SolidColorBrush>
        <SolidColorBrush x:Key="FgLabel">#7878A0</SolidColorBrush>
        <SolidColorBrush x:Key="FgMute">#666677</SolidColorBrush>
        <SolidColorBrush x:Key="FgDim">#3A3A48</SolidColorBrush>
        <SolidColorBrush x:Key="FgOff">#4A4A4A</SolidColorBrush>

        <!-- ── Section accents (hex values are the canonical set) ─────────── -->
        <SolidColorBrush x:Key="AccentOsc">#70C870</SolidColorBrush>
        <SolidColorBrush x:Key="AccentSeq">#E0C040</SolidColorBrush>
        <SolidColorBrush x:Key="AccentFilter">#F0A040</SolidColorBrush>
        <SolidColorBrush x:Key="AccentEnv">#40B0F0</SolidColorBrush>
        <SolidColorBrush x:Key="AccentLfo">#B070D8</SolidColorBrush>
        <SolidColorBrush x:Key="AccentVoice">#C05878</SolidColorBrush>
        <SolidColorBrush x:Key="AccentFx">#40C8A8</SolidColorBrush>
        <SolidColorBrush x:Key="AccentDm">#60A8E0</SolidColorBrush>
        <SolidColorBrush x:Key="AccentDmAlt">#7080F0</SolidColorBrush>
        <SolidColorBrush x:Key="AccentWarn">#D0702A</SolidColorBrush>

        <!-- ── Status colours (transient app state: errors, progress, etc.) ── -->
        <!-- Distinct from section accents even when hex overlaps; reference via
             Palette.StatusError/Ok/Warn/Info so semantics are explicit at call sites. -->
        <SolidColorBrush x:Key="StatusError">#FF6B6B</SolidColorBrush>
        <SolidColorBrush x:Key="StatusOk">#70C870</SolidColorBrush>
        <SolidColorBrush x:Key="StatusWarn">#F0A040</SolidColorBrush>
        <SolidColorBrush x:Key="StatusInfo">#AAAAAA</SolidColorBrush>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Toolbar chip button. Must live at app scope (not MainWindow.Styles)
             so popup Windows constructed in code-behind also pick it up. -->
        <Style Selector="Button.toolbar">
            <Setter Property="Padding"        Value="12,4"/>
            <Setter Property="FontSize"       Value="10.5"/>
            <Setter Property="Background"     Value="#1F1F26"/>
            <Setter Property="Foreground"     Value="#CCCCDD"/>
            <Setter Property="BorderBrush"    Value="#333344"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"   Value="3"/>
            <Setter Property="Height"         Value="26"/>
        </Style>
        <Style Selector="Button.toolbar /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1F1F26"/>
        </Style>
        <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#23232C"/>
        </Style>
        <Style Selector="Button.toolbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#181820"/>
        </Style>
        <Style Selector="Button.toolbar:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>

        <!-- Body paragraph used by dialog warnings, the Settings PRM hint, the
             About card, and the Inspector banner. Foreground stays per-instance
             because semantics (muted hint / primary body / warning) vary. -->
        <Style Selector="TextBlock.body">
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight"   Value="17"/>
        </Style>

        <!-- Tooltips: FluentTheme default is on the small side against the dark
             chrome. Bump to match body-paragraph size. -->
        <Style Selector="ToolTip">
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Application.Styles>
</Application>
