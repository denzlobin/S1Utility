<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="S1Utility.MainWindow"
        Title="S-1 Utility"
        Icon="/Assets/icon-256.png"
        Background="#1A1A1A"
        Width="1100" Height="1130"
        MinWidth="550" MinHeight="565">

    <Window.Resources>
        <!-- Shared brushes live in App.axaml's Application.Resources so the C#
             Theme helper can resolve them via Application.Current.Resources.
             This file only keeps legacy aliases still referenced by inline
             XAML styles further down — they should be migrated incrementally. -->

        <SolidColorBrush x:Key="BgBase">#111113</SolidColorBrush>
        <SolidColorBrush x:Key="BgRaised">#1A1A1E</SolidColorBrush>
        <SolidColorBrush x:Key="BgSurface">#222228</SolidColorBrush>
        <SolidColorBrush x:Key="BgElevated">#2A2A32</SolidColorBrush>
        <SolidColorBrush x:Key="BorderSub">#2C2C36</SolidColorBrush>
        <SolidColorBrush x:Key="BorderMid">#3A3A46</SolidColorBrush>
        <SolidColorBrush x:Key="TextPrimary">#E0E0E8</SolidColorBrush>
        <SolidColorBrush x:Key="TextSecondary">#9090A8</SolidColorBrush>
        <SolidColorBrush x:Key="TextMuted">#555566</SolidColorBrush>
        <SolidColorBrush x:Key="TextLabel">#7878A0</SolidColorBrush>
        <SolidColorBrush x:Key="TabControlHeaderBackground">#15151A</SolidColorBrush>
        <SolidColorBrush x:Key="TabControlHeaderBorderBrush">#2C2C36</SolidColorBrush>

        <!-- TabItem theme — flat text + 2px accent underline (matches mockup) -->
        <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#7878A0"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="CornerRadius"    Value="0"/>
            <Setter Property="Padding"         Value="14,7,14,5"/>
            <Setter Property="MinHeight"       Value="0"/>
            <Setter Property="MinWidth"        Value="0"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="Margin"          Value="0,0,4,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_LayoutRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Header}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          FontSize="{TemplateBinding FontSize}"
                                          Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Foreground" Value="#A0A0B5"/>
            </Style>
            <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
                <Setter Property="BorderBrush" Value="#CCCCDD"/>
            </Style>
            <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Foreground"  Value="#CCCCDD"/>
                <Setter Property="FontWeight"  Value="SemiBold"/>
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Window.Styles>
        <!-- Section card: flat dark surface, matches BuildPrmCard (Tab 2). -->
        <Style Selector="Border.section-card">
            <Setter Property="Background"       Value="#161616"/>
            <Setter Property="BorderBrush"      Value="#232323"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CornerRadius"     Value="4"/>
            <Setter Property="Padding"          Value="8,6"/>
            <Setter Property="Margin"           Value="0"/>
        </Style>

        <!-- Section title: accent caps, paired with a 6px accent dot + 1px gradient underline. -->
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize"          Value="8.5"/>
            <Setter Property="FontWeight"        Value="Bold"/>
            <Setter Property="LetterSpacing"     Value="1.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="6,0,0,0"/>
        </Style>
        <Style Selector="Ellipse.section-dot">
            <Setter Property="Width"             Value="6"/>
            <Setter Property="Height"            Value="6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Knob numeric value label (mono, dashboard-grey to match Tab 2 values) -->
        <Style Selector="TextBlock.param-value-label">
            <Setter Property="FontSize"            Value="9.5"/>
            <Setter Property="FontFamily"          Value="Cascadia Mono,Consolas,monospace"/>
            <Setter Property="Foreground"          Value="#A0A0B5"/>
            <Setter Property="TextAlignment"       Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin"              Value="0,3,0,0"/>
        </Style>

        <!-- Knob parameter label (label-grey, smaller) -->
        <Style Selector="TextBlock.param-label">
            <Setter Property="FontSize"            Value="9"/>
            <Setter Property="Foreground"          Value="#7878A0"/>
            <Setter Property="TextAlignment"       Value="Center"/>
            <Setter Property="TextWrapping"        Value="Wrap"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="LineHeight"          Value="11"/>
            <Setter Property="Margin"              Value="0,1,0,0"/>
        </Style>

        <!-- ComboBox param -->
        <Style Selector="ComboBox.param-combo">
            <Setter Property="MinWidth"    Value="90"/>
            <Setter Property="MaxWidth"    Value="120"/>
            <Setter Property="Height"      Value="26"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="Padding"     Value="6,3"/>
            <Setter Property="Background"  Value="#1E1E28"/>
            <Setter Property="BorderBrush" Value="#3A3A46"/>
        </Style>

        <!-- Toggle (CheckBox) parameter -->
        <Style Selector="CheckBox.param-toggle">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="Margin"     Value="4,6"/>
        </Style>

        <!-- Toolbar chip button (matches mockup chip palette: BgChip / BdChip) -->
        <Style Selector="Button.toolbar">
            <Setter Property="Padding"        Value="12,4"/>
            <Setter Property="FontSize"       Value="10.5"/>
            <Setter Property="Background"     Value="#1F1F26"/>
            <Setter Property="Foreground"     Value="#CCCCDD"/>
            <Setter Property="BorderBrush"    Value="#333344"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"   Value="3"/>
            <Setter Property="Height"         Value="26"/>
        </Style>
        <Style Selector="Button.toolbar /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1F1F26"/>
        </Style>
        <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#23232C"/>
        </Style>
        <Style Selector="Button.toolbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#181820"/>
        </Style>
        <Style Selector="Button.toolbar:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>

        <!-- Patch bank buttons -->
        <Style Selector="Button.patch-btn">
            <Setter Property="HorizontalAlignment"        Value="Stretch"/>
            <Setter Property="MinWidth"                   Value="30"/>
            <Setter Property="Height"                     Value="22"/>
            <Setter Property="FontSize"                   Value="9.5"/>
            <Setter Property="FontFamily"                 Value="Cascadia Mono,Consolas,monospace"/>
            <Setter Property="Padding"                    Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Background"                 Value="#1A1A24"/>
            <Setter Property="Foreground"                 Value="#9090A8"/>
            <Setter Property="BorderBrush"                Value="#33333D"/>
            <Setter Property="BorderThickness"            Value="1"/>
            <Setter Property="CornerRadius"               Value="2"/>
        </Style>
        <Style Selector="Button.patch-btn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1A1A24"/>
        </Style>
        <Style Selector="Button.patch-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#22222E"/>
        </Style>
        <Style Selector="Button.patch-btn-active">
            <Setter Property="Background"  Value="#1C3C1C"/>
            <Setter Property="Foreground"  Value="#80CC80"/>
            <Setter Property="BorderBrush" Value="#3A6A3A"/>
        </Style>
        <Style Selector="Button.patch-btn:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
        <Style Selector="Button.patch-btn-active:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
        <!-- Dirty slot: warm amber tint -->
        <Style Selector="Button.patch-btn-dirty">
            <Setter Property="Background"  Value="#281800"/>
            <Setter Property="Foreground"  Value="#B07828"/>
            <Setter Property="BorderBrush" Value="#6A4A18"/>
        </Style>
        <!-- Dirty + active: amber border on top of green background -->
        <Style Selector="Button.patch-btn-dirty.patch-btn-active">
            <Setter Property="Background"  Value="#1C3C1C"/>
            <Setter Property="Foreground"  Value="#80CC80"/>
            <Setter Property="BorderBrush" Value="#C07828"/>
        </Style>
        <!-- No backing PRM file: sunken / dim, still clickable (PC-only) -->
        <Style Selector="Button.patch-btn-noprm">
            <Setter Property="Background"  Value="#141420"/>
            <Setter Property="Foreground"  Value="#5C5C78"/>
            <Setter Property="BorderBrush" Value="#26262E"/>
        </Style>
        <Style Selector="Button.patch-btn-noprm /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#141420"/>
        </Style>
        <!-- No PRM + active: full active styling so selection still reads clearly -->
        <Style Selector="Button.patch-btn-noprm.patch-btn-active">
            <Setter Property="Background"  Value="#1C3C1C"/>
            <Setter Property="Foreground"  Value="#80CC80"/>
            <Setter Property="BorderBrush" Value="#3A6A3A"/>
        </Style>
        <!-- Malformed PRM file: red tint signalling parse error -->
        <Style Selector="Button.patch-btn-malformed">
            <Setter Property="Background"  Value="#2A0808"/>
            <Setter Property="Foreground"  Value="#B04848"/>
            <Setter Property="BorderBrush" Value="#6A2828"/>
        </Style>
        <!-- Malformed + active: green bg (selection) with red border (still flags error) -->
        <Style Selector="Button.patch-btn-malformed.patch-btn-active">
            <Setter Property="Background"  Value="#1C3C1C"/>
            <Setter Property="Foreground"  Value="#80CC80"/>
            <Setter Property="BorderBrush" Value="#C04848"/>
        </Style>
    </Window.Styles>

    <Viewbox Stretch="Uniform">
        <DockPanel Width="1100" Height="1130">

        <!-- ── Window header (logo + version + unsynced chip) ───────────── -->
        <Border DockPanel.Dock="Top"
                Background="#15151A"
                BorderBrush="#2C2C36"
                BorderThickness="0,0,0,1"
                Padding="14,0"
                Height="32">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4"
                            Background="#F0A040"
                            BoxShadow="0 0 6 0 #88F0A040"/>
                    <TextBlock Text="S-1 UTILITY"
                               FontSize="11.5" FontWeight="SemiBold"
                               Foreground="#CCCCDD" LetterSpacing="2"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel x:Name="UnsyncedChip"
                                Orientation="Horizontal" Spacing="5"
                                VerticalAlignment="Center"
                                IsVisible="False"
                                ToolTip.Tip="Parameters the editor has not confirmed from the synth.">
                        <Border Width="6" Height="6" CornerRadius="3"
                                Background="#F0A040"
                                BoxShadow="0 0 4 0 #88F0A040"/>
                        <TextBlock x:Name="UnsyncedChipText"
                                   FontSize="10"
                                   FontFamily="Cascadia Mono,Consolas,monospace"
                                   Foreground="#F0A040"
                                   LetterSpacing="0.8"
                                   VerticalAlignment="Center"
                                   Text="0 UNSYNCED"/>
                    </StackPanel>
                    <TextBlock Text="v1.0"
                               FontSize="9.5"
                               FontFamily="Cascadia Mono,Consolas,monospace"
                               Foreground="#3A3A48"
                               LetterSpacing="0.8"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Top bar / Toolbar (MIDI + edit history + preset + settings) ── -->
        <Border DockPanel.Dock="Top"
                Background="#181820"
                BorderBrush="#2C2C36"
                BorderThickness="0,0,0,1"
                Padding="14,6"
                Height="40">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Out" FontSize="9.5" Foreground="#7878A0"
                               VerticalAlignment="Center" LetterSpacing="0.4"/>
                    <ComboBox x:Name="DeviceCombo"
                              Width="130" Height="26" FontSize="10"
                              PlaceholderText="MIDI Out…"
                              Background="#1A1A24" BorderBrush="#333344"/>
                    <TextBlock Text="In" FontSize="9.5" Foreground="#7878A0"
                               VerticalAlignment="Center" LetterSpacing="0.4" Margin="2,0,0,0"/>
                    <ComboBox x:Name="InputCombo"
                              Width="130" Height="26" FontSize="10"
                              PlaceholderText="MIDI In…"
                              Background="#1A1A24" BorderBrush="#333344"/>
                    <Border Width="1" Height="18" Background="#2C2C36" Margin="4,0"/>
                    <Button x:Name="ConnectButton"
                            Classes="toolbar"
                            Content="Connect"/>
                    <Button x:Name="PanicButton"
                            Classes="toolbar"
                            Content="Panic"
                            IsEnabled="False"
                            ToolTip.Tip="Send All Sound Off + All Notes Off"/>
                    <Border Width="1" Height="18" Background="#2C2C36" Margin="4,0"/>
                    <Button x:Name="UndoButton"
                            Classes="toolbar"
                            Content="↶"
                            FontSize="13"
                            Padding="8,2"
                            IsEnabled="False"
                            ToolTip.Tip="Undo last edit (Ctrl+Z)"/>
                    <Button x:Name="RedoButton"
                            Classes="toolbar"
                            Content="↷"
                            FontSize="13"
                            Padding="8,2"
                            IsEnabled="False"
                            ToolTip.Tip="Redo (Ctrl+Y or Ctrl+Shift+Z)"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="SettingsButton"
                            Classes="toolbar"
                            Content="⚙"
                            FontSize="13"
                            Padding="8,2"
                            ToolTip.Tip="Settings"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ── Status footer (connection · status · MIDI activity) ──────── -->
        <Border DockPanel.Dock="Bottom"
                Background="#181820"
                BorderBrush="#2C2C36"
                BorderThickness="0,1,0,0"
                Padding="14,4"
                Height="24">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto">
                <Border Grid.Column="0"
                        x:Name="FooterConnDot"
                        Width="6" Height="6" CornerRadius="3"
                        Background="#2A2A33"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           x:Name="FooterConnText"
                           Text="Not connected"
                           FontSize="9.5"
                           FontFamily="Cascadia Mono,Consolas,monospace"
                           Foreground="#7878A0"
                           LetterSpacing="0.3"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"/>
                <TextBlock Grid.Column="2"
                           Text="·"
                           FontSize="9.5"
                           Foreground="#3A3A48"
                           VerticalAlignment="Center"
                           Margin="8,0,8,0"/>
                <TextBlock Grid.Column="3"
                           x:Name="StatusText"
                           Text=""
                           FontStyle="Italic"
                           FontSize="9.5"
                           Foreground="#7878A0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding #StatusText.Text}"/>
                <TextBlock Grid.Column="4"
                           x:Name="FooterMidiChText"
                           Text="CH 3"
                           FontSize="9.5"
                           FontFamily="Cascadia Mono,Consolas,monospace"
                           Foreground="#666677"
                           LetterSpacing="0.3"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           ToolTip.Tip="MIDI channel for parameter CC traffic"/>
                <TextBlock Grid.Column="5"
                           Text="·"
                           FontSize="9.5"
                           Foreground="#3A3A48"
                           VerticalAlignment="Center"
                           Margin="8,0,8,0"/>
                <TextBlock Grid.Column="6"
                           x:Name="FooterPcChText"
                           Text="PC CH 16"
                           FontSize="9.5"
                           FontFamily="Cascadia Mono,Consolas,monospace"
                           Foreground="#666677"
                           LetterSpacing="0.3"
                           VerticalAlignment="Center"
                           ToolTip.Tip="Program Change channel"/>
                <Border Grid.Column="7"
                        Width="1" Height="10"
                        Background="#2C2C36"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"/>
                <Border Grid.Column="8"
                        x:Name="MidiActivityDot"
                        Width="6" Height="6" CornerRadius="3"
                        Background="#2C2C3A"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        ToolTip.Tip="MIDI activity"/>
                <TextBlock Grid.Column="9"
                           x:Name="FooterActivityText"
                           Text="idle"
                           FontSize="9.5"
                           FontFamily="Cascadia Mono,Consolas,monospace"
                           Foreground="#666677"
                           LetterSpacing="0.3"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"/>
            </Grid>
        </Border>

        <!-- ── Pattern grid + action row (above footer) ─────────────────── -->
        <Border DockPanel.Dock="Bottom"
                Background="#0E0E12"
                BorderBrush="#2C2C36"
                BorderThickness="0,1,0,0"
                Padding="14,8,14,10">
            <StackPanel x:Name="PatchGridContainer"/>
        </Border>

        <!-- ── Tabs ───────────────────────────────────────────────────────── -->
        <Grid>
        <!-- Overlay: live heuristic feature toggles, aligned to the right edge of the
             section cards (cards have Margin=3 inside a content Grid with Margin=4
             → ~7px from the TabControl right edge). Built in code-behind. -->
        <StackPanel x:Name="LiveFeaturesPanel"
                    Orientation="Horizontal"
                    Spacing="4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,7,7,0"
                    ZIndex="1"/>

        <TabControl x:Name="MainTabs" Margin="7,0,7,0">

            <!-- ── Tab 1: Realtime Editor ──────────────────────────────── -->
            <TabItem Header="Realtime Editor">
                <Grid Margin="0"
                          ColumnDefinitions="*,*,*"
                          RowDefinitions="Auto,Auto,*"
                          ColumnSpacing="4"
                          RowSpacing="4">

                        <!-- OSCILLATOR (col 0, all rows) -->
                        <Border Classes="section-card" Grid.Column="0" Grid.Row="0" Grid.RowSpan="3">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Classes="section-dot" Fill="#F0A040"/>
                                    <TextBlock Classes="section-title" Text="OSCILLATOR" Foreground="#F0A040"/>
                                </StackPanel>
                                <Border Height="1" Margin="0,4,0,6">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#60F0A040"/>
                                            <GradientStop Offset="1" Color="#00F0A040"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel x:Name="OscillatorPanel" Spacing="3"/>
                            </StackPanel>
                        </Border>

                        <!-- FILTER -->
                        <Border Classes="section-card" Grid.Column="1" Grid.Row="0">
                            <StackPanel VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Classes="section-dot" Fill="#40B0F0"/>
                                    <TextBlock Classes="section-title" Text="FILTER" Foreground="#40B0F0"/>
                                </StackPanel>
                                <Border Height="1" Margin="0,4,0,6">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#6040B0F0"/>
                                            <GradientStop Offset="1" Color="#0040B0F0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel x:Name="FilterPanel"/>
                            </StackPanel>
                        </Border>

                        <!-- ENVELOPE -->
                        <Border Classes="section-card" Grid.Column="1" Grid.Row="1">
                            <StackPanel VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Classes="section-dot" Fill="#70C870"/>
                                    <TextBlock Classes="section-title" Text="ENVELOPE" Foreground="#70C870"/>
                                </StackPanel>
                                <Border Height="1" Margin="0,4,0,6">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#6070C870"/>
                                            <GradientStop Offset="1" Color="#0070C870"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel x:Name="EnvelopePanel"/>
                            </StackPanel>
                        </Border>

                        <!-- LFO (last row — stretches to fill remaining height) -->
                        <Border Classes="section-card" Grid.Column="1" Grid.Row="2">
                            <StackPanel VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Classes="section-dot" Fill="#B070D8"/>
                                    <TextBlock Classes="section-title" Text="LFO" Foreground="#B070D8"/>
                                </StackPanel>
                                <Border Height="1" Margin="0,4,0,6">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#60B070D8"/>
                                            <GradientStop Offset="1" Color="#00B070D8"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel x:Name="LfoPanel" Spacing="4"/>
                            </StackPanel>
                        </Border>

                        <!-- EFFECTS -->
                        <Border Classes="section-card" Grid.Column="2" Grid.Row="0">
                            <StackPanel x:Name="EffectsStack" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Classes="section-dot" Fill="#40C8A8"/>
                                    <TextBlock Classes="section-title" Text="EFFECTS" Foreground="#40C8A8"/>
                                </StackPanel>
                                <Border Height="1" Margin="0,4,0,6">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#6040C8A8"/>
                                            <GradientStop Offset="1" Color="#0040C8A8"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel x:Name="EffectsPanel"/>
                            </StackPanel>
                        </Border>

                        <!-- VOICE (stretches into * row) -->
                        <Border Classes="section-card" Grid.Column="2" Grid.Row="1" Grid.RowSpan="2">
                            <StackPanel VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Classes="section-dot" Fill="#C05878"/>
                                    <TextBlock Classes="section-title" Text="VOICE" Foreground="#C05878"/>
                                </StackPanel>
                                <Border Height="1" Margin="0,4,0,6">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#60C05878"/>
                                            <GradientStop Offset="1" Color="#00C05878"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel x:Name="VoicePanel" Spacing="3"/>
                            </StackPanel>
                        </Border>

                </Grid>

            </TabItem>

            <!-- ── Tab 2: Patch Inspector ──────────────────────────────── -->
            <TabItem Header="Patch Inspector">
                <Grid>

                    <!-- PRM viewer sections (populated by code) -->
                    <Grid x:Name="PrmViewerGrid"
                          Margin="4"
                          ColumnDefinitions="*,*"
                          RowDefinitions="*,Auto,Auto"
                          ColumnSpacing="4"
                          RowSpacing="4"/>

                    <!-- Empty-state banner (shown when no PRM folder is set or it has no .prm files) -->
                    <Border x:Name="InspectorBanner"
                            IsVisible="False"
                            Background="#181820"
                            BorderBrush="#3A3A46"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="40"
                            Padding="48,40"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="16"
                                    MaxWidth="560">
                            <TextBlock x:Name="InspectorBannerHeadline"
                                       Text="No patch data to inspect"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       LetterSpacing="1.5"
                                       Foreground="#E0E0E8"
                                       TextAlignment="Center"/>
                            <Border Height="1" Background="#3A3A46" Width="120" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="InspectorBannerPrimary"
                                       Text="Back up your patches from the synth, then point the PRM folder below at the resulting files."
                                       FontSize="13"
                                       Foreground="#A0A0B8"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       LineHeight="20"/>
                            <TextBlock x:Name="InspectorBannerSecondary"
                                       Text="The Patch Inspector reads .PRM files saved by the S-1. With a folder configured, this tab shows every parameter in the selected pattern, including the sequencer steps, draw wave, chop pattern, and D-Motion assigns that have no MIDI equivalent."
                                       FontSize="11"
                                       Foreground="#7878A0"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       LineHeight="17"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </TabItem>

        </TabControl>
        </Grid>

        </DockPanel>
    </Viewbox>
</Window>
