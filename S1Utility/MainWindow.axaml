<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="S1Utility.MainWindow"
        Title="S-1 Utility"
        Background="#1A1A1A"
        Width="1100" Height="1100"
        MinWidth="550" MinHeight="550">

    <Window.Resources>
        <!-- ── Background scale ──────────────────────────────────────────── -->
        <SolidColorBrush x:Key="BgBase">#111113</SolidColorBrush>
        <SolidColorBrush x:Key="BgRaised">#1A1A1E</SolidColorBrush>
        <SolidColorBrush x:Key="BgSurface">#222228</SolidColorBrush>
        <SolidColorBrush x:Key="BgElevated">#2A2A32</SolidColorBrush>
        <!-- ── Borders ────────────────────────────────────────────────────── -->
        <SolidColorBrush x:Key="BorderSub">#2C2C36</SolidColorBrush>
        <SolidColorBrush x:Key="BorderMid">#3A3A46</SolidColorBrush>
        <!-- ── Text ──────────────────────────────────────────────────────── -->
        <SolidColorBrush x:Key="TextPrimary">#E0E0E8</SolidColorBrush>
        <SolidColorBrush x:Key="TextSecondary">#9090A8</SolidColorBrush>
        <SolidColorBrush x:Key="TextMuted">#555566</SolidColorBrush>
        <SolidColorBrush x:Key="TextLabel">#7878A0</SolidColorBrush>
        <!-- ── Section accents ───────────────────────────────────────────── -->
        <SolidColorBrush x:Key="AccentOsc">#F0A040</SolidColorBrush>
        <SolidColorBrush x:Key="AccentFilter">#40AAEE</SolidColorBrush>
        <SolidColorBrush x:Key="AccentEnv">#60CC70</SolidColorBrush>
        <SolidColorBrush x:Key="AccentLfo">#B06ED8</SolidColorBrush>
        <SolidColorBrush x:Key="AccentFx">#3EC8A8</SolidColorBrush>
        <SolidColorBrush x:Key="AccentVoice">#C05878</SolidColorBrush>
        <SolidColorBrush x:Key="AccentWarn">#D0702A</SolidColorBrush>

        <!-- Tab strip background / border -->
        <SolidColorBrush x:Key="TabControlHeaderBackground">#1A1A1E</SolidColorBrush>
        <SolidColorBrush x:Key="TabControlHeaderBorderBrush">#2C2C36</SolidColorBrush>

        <!-- TabItem theme -->
        <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
            <Setter Property="Background"      Value="#1A1A1E"/>
            <Setter Property="Foreground"      Value="#404050"/>
            <Setter Property="BorderBrush"     Value="#2C2C36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="3"/>
            <Setter Property="Padding"         Value="18,6"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Margin"          Value="3,4,3,4"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_LayoutRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Header}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          FontSize="{TemplateBinding FontSize}"
                                          Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
                <Setter Property="Background"  Value="#252530"/>
                <Setter Property="BorderBrush" Value="#7070A0"/>
                <Setter Property="BoxShadow"   Value="0 0 8 0 #447070A0"/>
            </Style>
            <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Foreground"  Value="#C8C8D8"/>
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Window.Styles>
        <!-- Section card: raised surface with subtle top-highlight -->
        <Style Selector="Border.section-card">
            <Setter Property="Background"       Value="#222228"/>
            <Setter Property="BorderBrush"      Value="#2C2C36"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CornerRadius"     Value="5"/>
            <Setter Property="Padding"          Value="12"/>
            <Setter Property="Margin"           Value="3"/>
            <Setter Property="BoxShadow"        Value="inset 0 1 0 0 #FFFFFF0A"/>
        </Style>

        <!-- Section title: wider letter-spacing, accent separator added in XAML -->
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize"      Value="10.5"/>
            <Setter Property="FontWeight"    Value="Bold"/>
            <Setter Property="LetterSpacing" Value="2"/>
            <Setter Property="Margin"        Value="0,0,0,10"/>
        </Style>

        <!-- Knob numeric value label (mono, bright) -->
        <Style Selector="TextBlock.param-value-label">
            <Setter Property="FontSize"            Value="10"/>
            <Setter Property="FontFamily"          Value="Cascadia Mono,Consolas,monospace"/>
            <Setter Property="Foreground"          Value="#E0E0E8"/>
            <Setter Property="TextAlignment"       Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin"              Value="0,4,0,0"/>
        </Style>

        <!-- Knob parameter label (muted, smaller) -->
        <Style Selector="TextBlock.param-label">
            <Setter Property="FontSize"            Value="9"/>
            <Setter Property="Foreground"          Value="#7878A0"/>
            <Setter Property="TextAlignment"       Value="Center"/>
            <Setter Property="TextWrapping"        Value="Wrap"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin"              Value="0,4,0,0"/>
        </Style>

        <!-- ComboBox param -->
        <Style Selector="ComboBox.param-combo">
            <Setter Property="MinWidth"    Value="90"/>
            <Setter Property="MaxWidth"    Value="120"/>
            <Setter Property="Height"      Value="26"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="Padding"     Value="6,3"/>
            <Setter Property="Background"  Value="#1E1E28"/>
            <Setter Property="BorderBrush" Value="#3A3A46"/>
        </Style>

        <!-- Toggle (CheckBox) parameter -->
        <Style Selector="CheckBox.param-toggle">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="Margin"     Value="4,6"/>
        </Style>

        <!-- Toolbar button -->
        <Style Selector="Button.toolbar">
            <Setter Property="Padding"      Value="10,4"/>
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="Background"   Value="#252530"/>
            <Setter Property="Foreground"   Value="#BBBBCC"/>
            <Setter Property="BorderBrush"  Value="#383848"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="Button.toolbar /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#252530"/>
        </Style>
        <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#303040"/>
        </Style>
        <Style Selector="Button.toolbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1A1A24"/>
        </Style>

        <!-- Patch bank buttons -->
        <Style Selector="Button.patch-btn">
            <Setter Property="Width"                      Value="30"/>
            <Setter Property="Height"                     Value="22"/>
            <Setter Property="FontSize"                   Value="9"/>
            <Setter Property="FontFamily"                 Value="Cascadia Mono,Consolas,monospace"/>
            <Setter Property="Padding"                    Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Background"                 Value="#1E1E28"/>
            <Setter Property="Foreground"                 Value="#606078"/>
            <Setter Property="BorderBrush"                Value="#404050"/>
            <Setter Property="CornerRadius"               Value="2"/>
        </Style>
        <Style Selector="Button.patch-btn-active">
            <Setter Property="Background"  Value="#1C3C1C"/>
            <Setter Property="Foreground"  Value="#80CC80"/>
            <Setter Property="BorderBrush" Value="#3A6A3A"/>
        </Style>
        <Style Selector="Button.patch-btn:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
        <Style Selector="Button.patch-btn-active:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
        <!-- Dirty slot: warm amber tint -->
        <Style Selector="Button.patch-btn-dirty">
            <Setter Property="Background"  Value="#281800"/>
            <Setter Property="Foreground"  Value="#B07828"/>
            <Setter Property="BorderBrush" Value="#6A4A18"/>
        </Style>
        <!-- Dirty + active: amber border on top of green background -->
        <Style Selector="Button.patch-btn-dirty.patch-btn-active">
            <Setter Property="Background"  Value="#1C3C1C"/>
            <Setter Property="Foreground"  Value="#80CC80"/>
            <Setter Property="BorderBrush" Value="#C07828"/>
        </Style>
    </Window.Styles>

    <Viewbox Stretch="Uniform">
        <DockPanel Width="1100" Height="1100">

        <!-- ── Plugin title bar ─────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="#111113"
                BorderBrush="#2C2C36"
                BorderThickness="0,0,0,1"
                Padding="12,0"
                Height="30">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="6" Height="6" CornerRadius="3"
                            Background="#C8C8D8"
                            BoxShadow="0 0 4 1 #30C8C8D8"/>
                    <TextBlock Text="S-1 UTILITY"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#D8D8E8" LetterSpacing="1.5"/>
                </StackPanel>
                <TextBlock Text="v1.0" FontSize="9" Foreground="#404050"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ── Top bar (always visible) ──────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="#1A1A1E"
                BorderBrush="#2C2C36"
                BorderThickness="0,0,0,1"
                Padding="10,0"
                Height="40">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: MIDI device selection -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <ComboBox x:Name="DeviceCombo"
                              Width="130" Height="26" FontSize="10"
                              PlaceholderText="MIDI Out…"
                              Background="#1E1E28" BorderBrush="#3A3A46"/>
                    <ComboBox x:Name="InputCombo"
                              Width="130" Height="26" FontSize="10"
                              PlaceholderText="MIDI In…"
                              Background="#1E1E28" BorderBrush="#3A3A46"/>
                    <Button x:Name="ConnectButton"
                            Classes="toolbar"
                            Content="Connect"/>
                    <Button x:Name="PanicButton"
                            Classes="toolbar"
                            Content="Panic"
                            IsEnabled="False"
                            ToolTip.Tip="Send All Sound Off + All Notes Off"/>
                    <Border Width="1" Height="16" Background="#2C2C36" Margin="4,0"/>
                    <TextBlock x:Name="StatusText"
                               Foreground="#9090A8"
                               VerticalAlignment="Center"
                               MaxWidth="240"
                               TextTrimming="CharacterEllipsis"
                               FontSize="9.5"
                               ToolTip.Tip="{Binding #StatusText.Text}"/>
                    <Border x:Name="MidiActivityDot"
                            Width="5" Height="5"
                            CornerRadius="3"
                            Background="#2C2C3A"
                            VerticalAlignment="Center"
                            Margin="4,0,0,0"
                            ToolTip.Tip="MIDI activity"/>
                    <Border Width="1" Height="16" Background="#2C2C36" Margin="6,0,0,0"/>
                    <TextBlock x:Name="SyncIndicatorText"
                               FontSize="9"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"
                               Foreground="#F0A040"/>
                </StackPanel>

                <!-- Right: Edit history + preset management -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <Button x:Name="UndoButton"
                            Classes="toolbar"
                            Content="Undo"
                            IsEnabled="False"
                            ToolTip.Tip="Undo last edit (Ctrl+Z)"/>
                    <Button x:Name="RedoButton"
                            Classes="toolbar"
                            Content="Redo"
                            IsEnabled="False"
                            ToolTip.Tip="Redo (Ctrl+Y or Ctrl+Shift+Z)"/>
                    <Border Width="1" Height="16" Background="#2C2C36" Margin="0,0,4,0"/>
                    <TextBox x:Name="PresetNameBox"
                             Width="110" Height="26" FontSize="10"
                             Text="Untitled"
                             PlaceholderText="Preset name…"
                             Background="#1A1A24"
                             BorderBrush="#333344"
                             Foreground="#C0C0D0"
                             CornerRadius="3"/>
                    <Button x:Name="SaveButton"
                            Classes="toolbar"
                            Content="Save"/>
                    <Button x:Name="LoadButton"
                            Classes="toolbar"
                            Content="Load"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ── Pattern grid + settings (always visible) ─────────────────── -->
        <Border DockPanel.Dock="Bottom"
                Background="#1C1C22"
                BorderBrush="#2C2C36"
                BorderThickness="0,1,0,0"
                Padding="12,8,12,10">
            <Grid ColumnDefinitions="*,Auto,440">

                <StackPanel x:Name="PatchGridContainer" Grid.Column="0"/>

                <Border Grid.Column="1" Width="1" Background="#2C2C36" Margin="14,0"/>

                <StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center" Margin="14,0,0,0">

                    <!-- Live heuristic feature toggles (built in code-behind) -->
                    <StackPanel x:Name="LiveFeaturesPanel" Spacing="3"/>

                    <Border Height="1" Background="#2C2C36" Margin="0,1"/>

                    <!-- Channels -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,*" HorizontalAlignment="Stretch">
                        <TextBlock Grid.Column="0" Text="MIDI Channel" FontSize="9.5" Foreground="#7878A0" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="ChannelCombo"
                                  Margin="6,0,0,0" Height="24" FontSize="10"
                                  Background="#1E1E28" BorderBrush="#3A3A46"/>
                        <Border Grid.Column="2" Width="1" Height="14" Background="#2C2C36" Margin="4,0"/>
                        <TextBlock Grid.Column="3" Text="Program Change Channel" FontSize="9.5" Foreground="#7878A0" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="4" x:Name="ProgramChangeChannelCombo"
                                  Margin="6,0,0,0" Height="24" FontSize="10"
                                  Background="#1E1E28" BorderBrush="#3A3A46"/>
                    </Grid>

                    <!-- PRM Folder -->
                    <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                        <TextBlock Grid.Column="0" Text="PRM Folder" FontSize="9.5" Foreground="#7878A0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="PrmFolderBox"
                                 Margin="6,0,0,0" Height="24" FontSize="10"
                                 IsReadOnly="True"
                                 PlaceholderText="(not set)"
                                 Background="#1A1A24"
                                 BorderBrush="#333344"
                                 Foreground="#9090A8"
                                 CornerRadius="3"/>
                        <Button Grid.Column="2" x:Name="BrowsePrmFolderButton"
                                Margin="6,0,0,0"
                                Classes="toolbar"
                                Content="Browse…"/>
                    </Grid>

                </StackPanel>

            </Grid>
        </Border>

        <!-- ── Tabs ───────────────────────────────────────────────────────── -->
        <TabControl x:Name="MainTabs">

            <!-- ── Tab 1: Realtime Editor ──────────────────────────────── -->
            <TabItem Header="Realtime Editor">
                <Grid Margin="4"
                          ColumnDefinitions="*,*,*"
                          RowDefinitions="Auto,Auto,*"
                          ColumnSpacing="4"
                          RowSpacing="4">

                        <!-- OSCILLATOR (col 0, all rows) -->
                        <Border Classes="section-card" Grid.Column="0" Grid.Row="0" Grid.RowSpan="3">
                            <StackPanel>
                                <TextBlock Classes="section-title"
                                           Text="OSCILLATOR"
                                           Foreground="#F0A040"/>
                                <Border Height="1" Background="#F0A04055" Margin="0,0,0,10"/>
                                <StackPanel x:Name="OscillatorPanel"/>
                            </StackPanel>
                        </Border>

                        <!-- FILTER -->
                        <Border Classes="section-card" Grid.Column="1" Grid.Row="0">
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock Classes="section-title"
                                           Text="FILTER"
                                           Foreground="#40AAEE"/>
                                <Border Height="1" Background="#40AAEE55" Margin="0,0,0,10"/>
                                <StackPanel x:Name="FilterPanel"/>
                            </StackPanel>
                        </Border>

                        <!-- ENVELOPE -->
                        <Border Classes="section-card" Grid.Column="1" Grid.Row="1">
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock Classes="section-title"
                                           Text="ENVELOPE"
                                           Foreground="#60CC70"/>
                                <Border Height="1" Background="#60CC7055" Margin="0,0,0,10"/>
                                <StackPanel x:Name="EnvelopePanel"/>
                            </StackPanel>
                        </Border>

                        <!-- LFO (last row — stretches to fill remaining height) -->
                        <Border Classes="section-card" Grid.Column="1" Grid.Row="2">
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock Classes="section-title"
                                           Text="LFO"
                                           Foreground="#B06ED8"/>
                                <Border Height="1" Background="#B06ED855" Margin="0,0,0,10"/>
                                <StackPanel x:Name="LfoPanel"/>
                            </StackPanel>
                        </Border>

                        <!-- EFFECTS -->
                        <Border Classes="section-card" Grid.Column="2" Grid.Row="0">
                            <StackPanel x:Name="EffectsStack" VerticalAlignment="Top">
                                <TextBlock Classes="section-title"
                                           Text="EFFECTS"
                                           Foreground="#3EC8A8"/>
                                <Border Height="1" Background="#3EC8A855" Margin="0,0,0,10"/>
                                <StackPanel x:Name="EffectsPanel"/>
                            </StackPanel>
                        </Border>

                        <!-- VOICE (stretches into * row) -->
                        <Border Classes="section-card" Grid.Column="2" Grid.Row="1" Grid.RowSpan="2">
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock Classes="section-title"
                                           Text="VOICE"
                                           Foreground="#C05878"/>
                                <Border Height="1" Background="#C0587855" Margin="0,0,0,10"/>
                                <StackPanel x:Name="VoicePanel"/>
                            </StackPanel>
                        </Border>

                </Grid>

            </TabItem>

            <!-- ── Tab 2: Patch Inspector ──────────────────────────────── -->
            <TabItem Header="Patch Inspector">
                <DockPanel>

                    <!-- PRM viewer sections (populated by code) -->
                    <Grid x:Name="PrmViewerGrid"
                          Margin="4"
                          ColumnDefinitions="*,*,*"
                          RowDefinitions="Auto,Auto,Auto,*"
                          ColumnSpacing="4"
                          RowSpacing="4"/>

                </DockPanel>
            </TabItem>

        </TabControl>

        </DockPanel>
    </Viewbox>
</Window>
