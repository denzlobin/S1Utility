<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RolandS1Editor.MainWindow"
        Title="Roland S-1 Editor"
        Background="#1A1A1A"
        MinWidth="1100" MinHeight="755"
        Width="1100" Height="755">

    <Window.Resources>
        <!-- ── Background scale ──────────────────────────────────────────── -->
        <SolidColorBrush x:Key="BgBase">#111113</SolidColorBrush>
        <SolidColorBrush x:Key="BgRaised">#1A1A1E</SolidColorBrush>
        <SolidColorBrush x:Key="BgSurface">#222228</SolidColorBrush>
        <SolidColorBrush x:Key="BgElevated">#2A2A32</SolidColorBrush>
        <!-- ── Borders ────────────────────────────────────────────────────── -->
        <SolidColorBrush x:Key="BorderSub">#2C2C36</SolidColorBrush>
        <SolidColorBrush x:Key="BorderMid">#3A3A46</SolidColorBrush>
        <!-- ── Text ──────────────────────────────────────────────────────── -->
        <SolidColorBrush x:Key="TextPrimary">#E0E0E8</SolidColorBrush>
        <SolidColorBrush x:Key="TextSecondary">#9090A8</SolidColorBrush>
        <SolidColorBrush x:Key="TextMuted">#555566</SolidColorBrush>
        <SolidColorBrush x:Key="TextLabel">#7878A0</SolidColorBrush>
        <!-- ── Section accents ───────────────────────────────────────────── -->
        <SolidColorBrush x:Key="AccentOsc">#F0A040</SolidColorBrush>
        <SolidColorBrush x:Key="AccentFilter">#40AAEE</SolidColorBrush>
        <SolidColorBrush x:Key="AccentEnv">#60CC70</SolidColorBrush>
        <SolidColorBrush x:Key="AccentLfo">#B06ED8</SolidColorBrush>
        <SolidColorBrush x:Key="AccentFx">#3EC8A8</SolidColorBrush>
        <SolidColorBrush x:Key="AccentVoice">#F07040</SolidColorBrush>
        <SolidColorBrush x:Key="AccentWarn">#D0702A</SolidColorBrush>

        <!-- Tab strip background / border -->
        <SolidColorBrush x:Key="TabControlHeaderBackground">#1A1A1E</SolidColorBrush>
        <SolidColorBrush x:Key="TabControlHeaderBorderBrush">#2C2C36</SolidColorBrush>

        <!-- TabItem theme -->
        <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
            <Setter Property="Background"      Value="#1A1A1E"/>
            <Setter Property="Foreground"      Value="#404050"/>
            <Setter Property="BorderBrush"     Value="#2C2C36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="3"/>
            <Setter Property="Padding"         Value="18,6"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Margin"          Value="3,4,3,4"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_LayoutRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Header}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          FontSize="{TemplateBinding FontSize}"
                                          Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
                <Setter Property="Background"  Value="#252530"/>
                <Setter Property="BorderBrush" Value="#7070A0"/>
                <Setter Property="BoxShadow"   Value="0 0 8 0 #447070A0"/>
            </Style>
            <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Foreground"  Value="#C8C8D8"/>
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Window.Styles>
        <!-- Section card: raised surface with subtle top-highlight -->
        <Style Selector="Border.section-card">
            <Setter Property="Background"       Value="#222228"/>
            <Setter Property="BorderBrush"      Value="#2C2C36"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CornerRadius"     Value="5"/>
            <Setter Property="Padding"          Value="12"/>
            <Setter Property="Margin"           Value="3"/>
            <Setter Property="BoxShadow"        Value="inset 0 1 0 0 #FFFFFF0A"/>
        </Style>

        <!-- Section title: wider letter-spacing, accent separator added in XAML -->
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize"      Value="10.5"/>
            <Setter Property="FontWeight"    Value="Bold"/>
            <Setter Property="LetterSpacing" Value="2"/>
            <Setter Property="Margin"        Value="0,0,0,10"/>
        </Style>

        <!-- Knob numeric value label (mono, bright) -->
        <Style Selector="TextBlock.param-value-label">
            <Setter Property="FontSize"            Value="10"/>
            <Setter Property="FontFamily"          Value="Cascadia Mono,Consolas,monospace"/>
            <Setter Property="Foreground"          Value="#E0E0E8"/>
            <Setter Property="TextAlignment"       Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- Knob parameter label (muted, smaller) -->
        <Style Selector="TextBlock.param-label">
            <Setter Property="FontSize"            Value="9"/>
            <Setter Property="Foreground"          Value="#7878A0"/>
            <Setter Property="TextAlignment"       Value="Center"/>
            <Setter Property="TextWrapping"        Value="Wrap"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- ComboBox param -->
        <Style Selector="ComboBox.param-combo">
            <Setter Property="MinWidth"    Value="90"/>
            <Setter Property="MaxWidth"    Value="120"/>
            <Setter Property="Height"      Value="26"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="Padding"     Value="6,3"/>
            <Setter Property="Background"  Value="#1E1E28"/>
            <Setter Property="BorderBrush" Value="#3A3A46"/>
        </Style>

        <!-- Toggle (CheckBox) parameter -->
        <Style Selector="CheckBox.param-toggle">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="Margin"     Value="4,6"/>
        </Style>

        <!-- Toolbar button -->
        <Style Selector="Button.toolbar">
            <Setter Property="Padding"      Value="10,4"/>
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="Background"   Value="#252530"/>
            <Setter Property="Foreground"   Value="#BBBBCC"/>
            <Setter Property="BorderBrush"  Value="#383848"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="Button.toolbar /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#252530"/>
        </Style>
        <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#303040"/>
        </Style>
        <Style Selector="Button.toolbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1A1A24"/>
        </Style>

        <!-- Patch bank buttons -->
        <Style Selector="Button.patch-btn">
            <Setter Property="Width"                      Value="30"/>
            <Setter Property="Height"                     Value="22"/>
            <Setter Property="FontSize"                   Value="9"/>
            <Setter Property="FontFamily"                 Value="Cascadia Mono,Consolas,monospace"/>
            <Setter Property="Padding"                    Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Background"                 Value="#1E1E28"/>
            <Setter Property="Foreground"                 Value="#606078"/>
            <Setter Property="BorderBrush"                Value="#404050"/>
            <Setter Property="CornerRadius"               Value="2"/>
        </Style>
        <Style Selector="Button.patch-btn-active">
            <Setter Property="Background"  Value="#1C3C1C"/>
            <Setter Property="Foreground"  Value="#80CC80"/>
            <Setter Property="BorderBrush" Value="#3A6A3A"/>
        </Style>
        <Style Selector="Button.patch-btn:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
        <Style Selector="Button.patch-btn-active:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- ── Plugin title bar ─────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="#111113"
                BorderBrush="#2C2C36"
                BorderThickness="0,0,0,1"
                Padding="12,0"
                Height="30">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4"
                            Background="#F0A040"
                            BoxShadow="0 0 8 2 #88F0A040"/>
                    <TextBlock Text="ROLAND S-1 EDITOR"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#D8D8E8" LetterSpacing="1.5"/>
                </StackPanel>
                <TextBlock Text="v1.0" FontSize="9" Foreground="#404050"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ── Top bar (always visible) ──────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="#1A1A1E"
                BorderBrush="#2C2C36"
                BorderThickness="0,0,0,1"
                Padding="10,0"
                Height="40">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: MIDI device selection + toggles -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <ComboBox x:Name="DeviceCombo"
                              Width="130" Height="26" FontSize="10"
                              PlaceholderText="MIDI Out…"
                              Background="#1E1E28" BorderBrush="#3A3A46"/>
                    <ComboBox x:Name="InputCombo"
                              Width="130" Height="26" FontSize="10"
                              PlaceholderText="MIDI In…"
                              Background="#1E1E28" BorderBrush="#3A3A46"/>
                    <TextBlock Text="Ch"
                               Foreground="#555566"
                               VerticalAlignment="Center"
                               FontSize="10"/>
                    <ComboBox x:Name="ChannelCombo"
                              Width="50" Height="26" FontSize="10"
                              Background="#1E1E28" BorderBrush="#3A3A46"/>
                    <Button x:Name="ConnectButton"
                            Classes="toolbar"
                            Content="Connect"/>
                    <Button x:Name="SendAllButton"
                            Classes="toolbar"
                            Content="Send All"
                            IsEnabled="False"/>

                    <!-- Separator before toggles -->
                    <Border Width="1" Height="16" Background="#2C2C36" Margin="4,0"/>

                    <CheckBox x:Name="AutoConnectToggle"
                              Content="Auto S-1"
                              Foreground="#888898"
                              FontSize="9.5"
                              VerticalAlignment="Center"/>
                    <CheckBox x:Name="FilterModToggle"
                              Content="Filter Mod"
                              Foreground="#888898"
                              FontSize="9.5"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Experimental: animates the filter curve to simulate envelope and LFO modulation. Based on heuristics — behaviour may not match hardware exactly."/>
                    <CheckBox x:Name="PatternSyncToggle"
                              Content="Pattern Sync"
                              Foreground="#D0702A"
                              FontSize="9.5"
                              VerticalAlignment="Center"
                              IsEnabled="False"
                              ToolTip.Tip="Experimental: auto-loads PRM data when switching patterns. Requires a PRM Folder. Files must exactly match the device — it is your responsibility to keep them in sync."/>
                    <TextBlock x:Name="StatusText"
                               Foreground="#555566"
                               Opacity="0.8"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"
                               MaxWidth="80"
                               TextTrimming="CharacterEllipsis"
                               FontSize="9.5"
                               FontStyle="Italic"
                               ToolTip.Tip="{Binding #StatusText.Text}"/>
                </StackPanel>

                <!-- Right: Preset management -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <Border Width="1" Height="16" Background="#2C2C36" Margin="0,0,4,0"/>
                    <TextBox x:Name="PresetNameBox"
                             Width="110" Height="26" FontSize="10"
                             Text="Untitled"
                             PlaceholderText="Preset name…"
                             Background="#1A1A24"
                             BorderBrush="#333344"
                             Foreground="#C0C0D0"
                             CornerRadius="3"/>
                    <Button x:Name="SaveButton"
                            Classes="toolbar"
                            Content="Save"/>
                    <Button x:Name="LoadButton"
                            Classes="toolbar"
                            Content="Load"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ── Pattern grid (always visible, shared across tabs) ──────────── -->
        <Border DockPanel.Dock="Bottom"
                Background="#1C1C22"
                BorderBrush="#2C2C36"
                BorderThickness="0,1,0,0"
                Padding="12,8,12,10">
            <StackPanel x:Name="PatchGridContainer" IsEnabled="False"/>
        </Border>

        <!-- ── Tabs ───────────────────────────────────────────────────────── -->
        <TabControl>

            <!-- ── Tab 1: Realtime Editor ──────────────────────────────── -->
            <TabItem Header="Realtime Editor">
                <Grid Margin="4"
                          ColumnDefinitions="*,*,*"
                          RowDefinitions="Auto,Auto,*"
                          ColumnSpacing="4"
                          RowSpacing="4">

                        <!-- OSCILLATOR (col 0, all rows) -->
                        <Border Classes="section-card" Grid.Column="0" Grid.Row="0" Grid.RowSpan="3">
                            <StackPanel>
                                <TextBlock Classes="section-title"
                                           Text="OSCILLATOR"
                                           Foreground="#F0A040"/>
                                <Border Height="1" Background="#F0A04033" Margin="0,0,0,10"/>
                                <StackPanel x:Name="OscillatorPanel"/>
                            </StackPanel>
                        </Border>

                        <!-- FILTER -->
                        <Border Classes="section-card" Grid.Column="1" Grid.Row="0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Classes="section-title"
                                           Text="FILTER"
                                           Foreground="#40AAEE"/>
                                <Border Height="1" Background="#40AAEE33" Margin="0,0,0,10"/>
                                <StackPanel x:Name="FilterPanel"/>
                            </StackPanel>
                        </Border>

                        <!-- ENVELOPE -->
                        <Border Classes="section-card" Grid.Column="1" Grid.Row="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Classes="section-title"
                                           Text="ENVELOPE"
                                           Foreground="#60CC70"/>
                                <Border Height="1" Background="#60CC7033" Margin="0,0,0,10"/>
                                <StackPanel x:Name="EnvelopePanel"/>
                            </StackPanel>
                        </Border>

                        <!-- LFO (last row — stretches to fill remaining height) -->
                        <Border Classes="section-card" Grid.Column="1" Grid.Row="2">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Classes="section-title"
                                           Text="LFO"
                                           Foreground="#B06ED8"/>
                                <Border Height="1" Background="#B06ED833" Margin="0,0,0,10"/>
                                <StackPanel x:Name="LfoPanel"/>
                            </StackPanel>
                        </Border>

                        <!-- EFFECTS -->
                        <Border Classes="section-card" Grid.Column="2" Grid.Row="0">
                            <StackPanel x:Name="EffectsStack" VerticalAlignment="Center">
                                <TextBlock Classes="section-title"
                                           Text="EFFECTS"
                                           Foreground="#3EC8A8"/>
                                <Border Height="1" Background="#3EC8A833" Margin="0,0,0,10"/>
                                <StackPanel x:Name="EffectsPanel"/>
                            </StackPanel>
                        </Border>

                        <!-- VOICE (stretches into * row) -->
                        <Border Classes="section-card" Grid.Column="2" Grid.Row="1" Grid.RowSpan="2">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Classes="section-title"
                                           Text="VOICE"
                                           Foreground="#F07040"/>
                                <Border Height="1" Background="#F0704033" Margin="0,0,0,10"/>
                                <StackPanel x:Name="VoicePanel"/>
                            </StackPanel>
                        </Border>

                </Grid>

            </TabItem>

            <!-- ── Tab 2: PRM Viewer ────────────────────────────────────── -->
            <TabItem Header="PRM Viewer">
                <DockPanel>

                    <!-- PRM toolbar row -->
                    <Border DockPanel.Dock="Top"
                            Background="#1A1A1E"
                            BorderBrush="#2C2C36"
                            BorderThickness="0,0,0,1"
                            Padding="12,10">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="OpenPrmButton"
                                        Classes="toolbar"
                                        Content="Open PRM File"/>
                                <Border Width="1" Height="16" Background="#2C2C36" Margin="4,0"/>
                                <TextBlock Text="PRM Folder"
                                           Foreground="#555566"
                                           VerticalAlignment="Center"
                                           FontSize="10"/>
                                <TextBox x:Name="PrmFolderBox"
                                         Width="280"
                                         Height="26"
                                         FontSize="10"
                                         IsReadOnly="True"
                                         PlaceholderText="(not set — click Browse to choose)"
                                         Background="#1A1A24"
                                         BorderBrush="#333344"
                                         Foreground="#9090A8"
                                         CornerRadius="3"/>
                                <Button x:Name="BrowsePrmFolderButton"
                                        Classes="toolbar"
                                        Content="Browse…"/>
                            </StackPanel>
                            <TextBlock Foreground="#555566"
                                       FontSize="9.5"
                                       FontStyle="Italic"
                                       TextWrapping="Wrap"
                                       MaxWidth="860"
                                       Text="To access patch files on the S-1: connect USB, then hold PLAY while powering on. Files are in the BACKUP folder. To restore: copy files to RESTORE folder, eject, then press HOLD on the device."/>
                        </StackPanel>
                    </Border>

                    <!-- PRM viewer sections (populated by code) -->
                    <Grid x:Name="PrmViewerGrid"
                          Margin="4"
                          ColumnDefinitions="*,*,*"
                          RowDefinitions="Auto,Auto,Auto,*"
                          ColumnSpacing="4"
                          RowSpacing="4"/>

                </DockPanel>
            </TabItem>

        </TabControl>

    </DockPanel>
</Window>
